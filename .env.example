# Copy to .env.local and fill in. Never commit real values. See docs/ENV_SETUP.md.

# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret, server only
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: payments / donations ---
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Optional: transactional email ---
RESEND_API_KEY=
EMAIL_FROM=Web3tribe University <no-reply@yourdomain.com>

# --- Optional: shared rate limiting (recommended in production; free tier is enough) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
